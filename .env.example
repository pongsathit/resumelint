# ==============================================================================
# Docker Compose Environment Variables (Example)
# Copy this file to .env for docker-compose to use
# ==============================================================================

# Project name (used for Docker container/network naming)
COMPOSE_PROJECT_NAME=resumelint

# Node environment
NODE_ENV=development

# Backend configuration
BACKEND_PORT=3000

# Frontend configuration
FRONTEND_PORT=5173
FRONTEND_PORT_PROD=80

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Database name
POSTGRES_DB=resumelint

# Database user
POSTGRES_USER=resumelint_user

# Database password (CHANGE THIS IN PRODUCTION!)
POSTGRES_PASSWORD=resumelint_password

# Optional: Uncomment to expose database port to host (for database GUI tools)
# WARNING: Not recommended for production. Use docker exec instead.
# POSTGRES_PORT=5432
