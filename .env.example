# ==============================================================================
# Docker Compose Environment Variables (Example)
# Copy this file to .env for docker-compose to use
# ==============================================================================

# Project name (used for Docker container/network naming)
COMPOSE_PROJECT_NAME=resumelint

# Node environment
NODE_ENV=development

# Backend configuration
BACKEND_PORT=3000

# Frontend configuration
FRONTEND_PORT=5173
FRONTEND_PORT_PROD=80
