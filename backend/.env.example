PORT=3000
NODE_ENV=development
JWT_SECRET=your-secret-key-here

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# When running with Docker Compose, use 'database' as the host
# When running locally without Docker, use 'localhost'
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=resumelint
DATABASE_USER=resumelint_user
DATABASE_PASSWORD=resumelint_password

# Optional: Database connection string (alternative to individual variables)
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://resumelint_user:resumelint_password@database:5432/resumelint

# Optional: Database connection pool settings
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=3000
